# ==========================================
# Trippin' AI — Environment Configuration
# ==========================================

# Environment Mode (development | staging | production)
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# Authentication
# Set to 'true' for local development bypass without Firebase credentials
AUTH_BYPASS_DEV=true
FIREBASE_PROJECT_ID=trippin-ai-dev
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@trippin-ai-dev.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# PostgreSQL + PostGIS Database
DATABASE_URL="postgresql://trippin_user:trippin_secret_pass@localhost:5432/trippin_ai_dev?schema=public"
DB_USER=trippin_user
DB_PASSWORD=trippin_secret_pass
DB_NAME=trippin_ai_dev
DB_PORT=5432

# Redis Cache & BullMQ Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# OpenAI API
OPENAI_API_KEY=sk-placeholder-openai-key
OPENAI_MODEL=gpt-4o

# Google Maps Platform (Places API & Routes API)
GOOGLE_MAPS_API_KEY=placeholder-google-maps-key
ENABLE_MOCK_GOOGLE_PROVIDERS=true

# Weather API
WEATHER_API_KEY=placeholder-weather-key
ENABLE_MOCK_WEATHER_PROVIDER=true

# Firebase Cloud Messaging (Push Notifications)
FCM_SERVER_KEY=placeholder-fcm-key

# Telemetry & Logging
LOG_LEVEL=debug
