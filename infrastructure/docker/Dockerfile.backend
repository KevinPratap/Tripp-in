# Multi-stage production build for NestJS Backend
FROM node:22-alpine AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

FROM base AS builder
WORKDIR /app
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY packages/ ./packages/
COPY apps/backend/ ./apps/backend/

RUN pnpm install
RUN pnpm --filter @trippin/shared-types run build
RUN pnpm --filter @trippin/itinerary-schema run build
RUN pnpm --filter @trippin/api-contracts run build
RUN pnpm --filter @trippin/backend run prisma:generate
RUN pnpm --filter @trippin/backend run build

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/apps/backend ./apps/backend

EXPOSE 4000
CMD ["sh", "-c", "cd apps/backend && npx prisma db push --skip-generate && cd /app && node apps/backend/dist/src/main.js"]
