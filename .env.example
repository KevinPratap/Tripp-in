# ==============================================================================
# Trippin' AI — Environment Configuration (Zero-Cost / Free-Tier Supported)
# ==============================================================================

NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# ------------------------------------------------------------------------------
# 1. AI LLM Provider: Google Gemini 2.5 Flash (free tier)
# ------------------------------------------------------------------------------
# Get a free Gemini API key from Google AI Studio: https://aistudio.google.com/app/apikey
# Either GEMINI_API_KEY or OPENAI_API_KEY is read; GEMINI_API_KEY selects the native client.
GEMINI_API_KEY=""
OPENAI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
OPENAI_API_KEY="AIzaSyPlaceholderGeminiKey"
OPENAI_MODEL="gemini-2.5-flash"

# Alternative: Groq Cloud (100% FREE - Ultra-Fast Llama 3.3 70B, 14,400 req/day)
# OPENAI_BASE_URL="https://api.groq.com/openai/v1"
# OPENAI_API_KEY="gsk_..."
# OPENAI_MODEL="llama-3.3-70b-versatile"

# Alternative: Standard OpenAI
# OPENAI_BASE_URL="https://api.openai.com/v1"
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4o"

# ------------------------------------------------------------------------------
# 2. Weather Engine (100% Free - Open-Meteo)
# ------------------------------------------------------------------------------
# Built-in live Open-Meteo provider requires ZERO API keys and $0 cost!
ENABLE_MOCK_WEATHER_PROVIDER=false

# ------------------------------------------------------------------------------
# 3. Maps, Places & Routing (100% Free OSRM & OpenStreetMap)
# ------------------------------------------------------------------------------
# Built-in live OSRM provider calculates real driving/transit times with $0 cost!
ENABLE_MOCK_GOOGLE_PROVIDERS=true
GOOGLE_MAPS_API_KEY=placeholder-google-maps-key

# ------------------------------------------------------------------------------
# 4. Database & Cache (Free Cloud Tiers)
# ------------------------------------------------------------------------------
# Local Docker or Free Supabase Postgres with PostGIS (https://supabase.com)
DATABASE_URL="postgresql://trippin_user:trippin_secret_pass@localhost:5432/trippin_ai_dev?schema=public"

# Local Redis or Free Upstash Serverless Redis (https://upstash.com)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 5. Authentication (Local Dev Bypass or Free Firebase Spark Plan)
# ------------------------------------------------------------------------------
AUTH_BYPASS_DEV=true

# Sign in is passwordless. Set BOTH of these to email the magic link; leave either blank
# and the link is written to the server log instead, and the API says delivery is "console"
# rather than claiming an email was sent.
#
# Free tier: Resend allows 3,000 emails a month (https://resend.com). MAIL_FROM has to be an
# address on a domain verified in the Resend dashboard.
#
# Outside production the API also returns the link in the response body, as a developer
# convenience. In production it never does: this route needs no identity, so a token in the
# response would hand anyone a session for any address they can name.
RESEND_API_KEY=""
MAIL_FROM=""

# Where the magic link points. Must be the deployed web app, not the API.
PUBLIC_WEB_URL="http://localhost:3000"
FIREBASE_PROJECT_ID=trippin-ai-dev
LOG_LEVEL=debug
